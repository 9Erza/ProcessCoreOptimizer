<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Original PCO vector glyphs (no third-party assets, no emoji).
         x:Shared="False" so each usage gets its own instance.
         Strokes bind to the host Button Foreground and follow hover/focus. -->

