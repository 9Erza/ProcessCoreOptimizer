<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Process Core Optimizer design tokens (2.1 "Fluent dark").
         Neutral, low-contrast surfaces; a single blue accent for primary actions
         and selection; semantic colors only for state (success / warning / danger).
         All keys from 2.0 are kept so every view keeps resolving. -->

    <!-- Surfaces: Bg0 = window, Bg1 = sidebar + cards, Bg2 = raised, Bg3 = inputs / tiles. -->
    <Color x:Key="PcoBg0">#0F1013</Color>
    <Color x:Key="PcoBg1">#16171B</Color>
    <Color x:Key="PcoBg2">#1B1D22</Color>
    <Color x:Key="PcoBg3">#202228</Color>
    <Color x:Key="PcoLogBg">#0C0D10</Color>
    <Color x:Key="PcoBorder">#272A31</Color>
    <Color x:Key="PcoBorderSoft">#22252B</Color>
    <Color x:Key="PcoBorderStrong">#353943</Color>

    <!-- Text -->
    <Color x:Key="PcoText">#E4E6EA</Color>
    <Color x:Key="PcoTextBright">#FFFFFF</Color>
    <Color x:Key="PcoMuted">#9AA0A9</Color>
    <Color x:Key="PcoMuted2">#AEB3BB</Color>
    <Color x:Key="PcoDim">#727882</Color>
    <Color x:Key="PcoFaint">#555A63</Color>

    <!-- Accent -->
    <Color x:Key="PcoAccent">#4C8DFF</Color>
    <Color x:Key="PcoAccentHover">#649CFF</Color>
    <Color x:Key="PcoAccentPressed">#3D78E0</Color>
    <Color x:Key="PcoAccentLight">#8FB6FF</Color>
    <Color x:Key="PcoAccentDark">#1C2A45</Color>
    <Color x:Key="PcoAccentSubtle">#182235</Color>

    <!-- Semantic -->
    <Color x:Key="PcoGreen">#3CCB7F</Color>
    <Color x:Key="PcoRed">#F0565C</Color>
    <Color x:Key="PcoOrange">#F2A93B</Color>
    <Color x:Key="PcoPurple">#A58BFA</Color>
    <Color x:Key="PcoYellow">#E9C84A</Color>
    <Color x:Key="PcoGreenSubtle">#14271D</Color>
    <Color x:Key="PcoRedSubtle">#2C1617</Color>
    <Color x:Key="PcoOrangeSubtle">#2B2214</Color>

    <!-- Interaction -->
    <Color x:Key="PcoAltRow">#16171B</Color>
    <Color x:Key="PcoSelected">#1F2B42</Color>
    <Color x:Key="PcoHover">#23262D</Color>
    <Color x:Key="PcoPressed">#1C1E24</Color>
    <Color x:Key="PcoControl">#1D1F25</Color>
    <Color x:Key="PcoTrack">#2A2D34</Color>

    <SolidColorBrush x:Key="PcoBg0Brush" Color="{StaticResource PcoBg0}"/>
    <SolidColorBrush x:Key="PcoBg1Brush" Color="{StaticResource PcoBg1}"/>
    <SolidColorBrush x:Key="PcoBg2Brush" Color="{StaticResource PcoBg2}"/>
    <SolidColorBrush x:Key="PcoBg3Brush" Color="{StaticResource PcoBg3}"/>
    <SolidColorBrush x:Key="PcoLogBgBrush" Color="{StaticResource PcoLogBg}"/>
    <SolidColorBrush x:Key="PcoBorderBrush" Color="{StaticResource PcoBorder}"/>
    <SolidColorBrush x:Key="PcoBorderSoftBrush" Color="{StaticResource PcoBorderSoft}"/>
    <SolidColorBrush x:Key="PcoBorderStrongBrush" Color="{StaticResource PcoBorderStrong}"/>
    <SolidColorBrush x:Key="PcoTextBrush" Color="{StaticResource PcoText}"/>
    <SolidColorBrush x:Key="PcoTextBrightBrush" Color="{StaticResource PcoTextBright}"/>
    <SolidColorBrush x:Key="PcoMutedBrush" Color="{StaticResource PcoMuted}"/>
    <SolidColorBrush x:Key="PcoMuted2Brush" Color="{StaticResource PcoMuted2}"/>
    <SolidColorBrush x:Key="PcoDimBrush" Color="{StaticResource PcoDim}"/>
    <SolidColorBrush x:Key="PcoFaintBrush" Color="{StaticResource PcoFaint}"/>
    <SolidColorBrush x:Key="PcoAccentBrush" Color="{StaticResource PcoAccent}"/>
    <SolidColorBrush x:Key="PcoAccentHoverBrush" Color="{StaticResource PcoAccentHover}"/>
    <SolidColorBrush x:Key="PcoAccentPressedBrush" Color="{StaticResource PcoAccentPressed}"/>
    <SolidColorBrush x:Key="PcoAccentLightBrush" Color="{StaticResource PcoAccentLight}"/>
    <SolidColorBrush x:Key="PcoAccentDarkBrush" Color="{StaticResource PcoAccentDark}"/>
    <SolidColorBrush x:Key="PcoAccentSubtleBrush" Color="{StaticResource PcoAccentSubtle}"/>
    <SolidColorBrush x:Key="PcoGreenBrush" Color="{StaticResource PcoGreen}"/>
    <SolidColorBrush x:Key="PcoRedBrush" Color="{StaticResource PcoRed}"/>
    <SolidColorBrush x:Key="PcoOrangeBrush" Color="{StaticResource PcoOrange}"/>
    <SolidColorBrush x:Key="PcoPurpleBrush" Color="{StaticResource PcoPurple}"/>
    <SolidColorBrush x:Key="PcoYellowBrush" Color="{StaticResource PcoYellow}"/>
    <SolidColorBrush x:Key="PcoGreenSubtleBrush" Color="{StaticResource PcoGreenSubtle}"/>
    <SolidColorBrush x:Key="PcoRedSubtleBrush" Color="{StaticResource PcoRedSubtle}"/>
    <SolidColorBrush x:Key="PcoOrangeSubtleBrush" Color="{StaticResource PcoOrangeSubtle}"/>
    <SolidColorBrush x:Key="PcoAltRowBrush" Color="{StaticResource PcoAltRow}"/>
    <SolidColorBrush x:Key="PcoSelectedBrush" Color="{StaticResource PcoSelected}"/>
    <SolidColorBrush x:Key="PcoHoverBrush" Color="{StaticResource PcoHover}"/>
    <SolidColorBrush x:Key="PcoPressedBrush" Color="{StaticResource PcoPressed}"/>
    <SolidColorBrush x:Key="PcoControlBrush" Color="{StaticResource PcoControl}"/>
    <SolidColorBrush x:Key="PcoTrackBrush" Color="{StaticResource PcoTrack}"/>

    <!-- Type scale. Segoe UI Variable (Windows 11) with Segoe UI fallback. -->
    <FontFamily x:Key="PcoFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="PcoDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="PcoIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="PcoMonoFont">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="PcoTitleSize">22</sys:Double>
    <sys:Double x:Key="PcoSectionSize">14</sys:Double>
    <sys:Double x:Key="PcoBodySize">13</sys:Double>
    <sys:Double x:Key="PcoSmallSize">12</sys:Double>
    <sys:Double x:Key="PcoTinySize">11</sys:Double>

    <Thickness x:Key="PcoCardPadding">20</Thickness>
    <CornerRadius x:Key="PcoCardRadius">10</CornerRadius>
    <CornerRadius x:Key="PcoControlRadius">6</CornerRadius>
    <CornerRadius x:Key="PcoSmallRadius">4</CornerRadius>

</ResourceDictionary>
