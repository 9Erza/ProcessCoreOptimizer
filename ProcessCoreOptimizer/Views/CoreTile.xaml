<UserControl x:Class="ProcessCoreOptimizer.WPF.Views.CoreTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="128" Height="58">
    <Border x:Name="TileBorder" Margin="4" Padding="10,7" CornerRadius="8" BorderThickness="1" SnapsToDevicePixels="True">
        <Border.ToolTip>
            <StackPanel>
                <TextBlock>
                    <Run Text="{DynamicResource StrCpuUtility}"/><Run Text=": "/><Run Text="{Binding UtilityText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{DynamicResource StrUtilityNote}" Foreground="{StaticResource PcoMutedBrush}" FontSize="11" TextWrapping="Wrap" MaxWidth="220" Margin="0,2,0,0"/>
            </StackPanel>
        </Border.ToolTip>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PcoBg2Brush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PcoBorderSoftBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPreviewHighlighted, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Background" Value="{StaticResource PcoAccentSubtleBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource PcoAccentBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="TileCheck" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"
                          IsChecked="{Binding IsTileChecked, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
                <Ellipse x:Name="ReadOnlyDot" Grid.Column="0" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource PcoFaintBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewHighlighted, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource PcoAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Grid.Column="1" Text="{Binding TileLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                           Foreground="{StaticResource PcoTextBrightBrush}" FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding LoadUsage, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay, StringFormat={}{0:F0}%}"/>
                            <Setter Property="Foreground" Value="{StaticResource PcoMutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadAvailable, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Text" Value="—"/>
                                    <Setter Property="Foreground" Value="{StaticResource PcoFaintBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <ProgressBar Grid.Row="1" Value="{Binding LoadUsage, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                         Maximum="100" Height="3" Margin="0,8,0,0">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoadAvailable, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Opacity" Value="0.25"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </Grid>
    </Border>
</UserControl>
