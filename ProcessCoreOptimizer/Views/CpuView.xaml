<UserControl x:Class="ProcessCoreOptimizer.WPF.Views.CpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ProcessCoreOptimizer.WPF.Views"
             xmlns:conv="clr-namespace:ProcessCoreOptimizer.WPF.Converters">
    <UserControl.Resources>
        <conv:PreviewHighlightConverter x:Key="PreviewHighlightConverter"/>
    </UserControl.Resources>
    <Border Style="{StaticResource PcoCard}" Margin="0,0,25,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{DynamicResource StrCpuCores}" Style="{StaticResource PcoTitle}"/>

                <!-- Informational only: no process, no mutation. Presets preview a selection. -->
                <TextBlock Text="{DynamicResource StrProcessorOverview}" Style="{StaticResource PcoSectionHeader}"/>
                <Border Background="{StaticResource PcoBg3Brush}" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderThickness="1" BorderBrush="{StaticResource PcoBorderSoftBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding CpuModelText, Mode=OneWay}" Foreground="{StaticResource PcoTextBrightBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <TextBlock Foreground="{StaticResource PcoMutedBrush}" FontSize="12" Margin="0,0,0,2">
                            <Run Text="{Binding LogicalProcessorCount, Mode=OneWay}"/><Run Text=" LP · "/><Run Text="{Binding PhysicalCoreCount, Mode=OneWay}"/><Run Text=" cores"/>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource PcoMutedBrush}" FontSize="12" Margin="0,0,0,2">
                            <Run Text="SMT ×"/><Run Text="{Binding SmtThreadCount, Mode=OneWay}"/><Run Text=" · P "/><Run Text="{Binding PerformanceCoreCount, Mode=OneWay}"/><Run Text=" · E "/><Run Text="{Binding EfficiencyCoreCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource PcoMutedBrush}" FontSize="12">
                            <Run Text="Affinity "/><Run Text="{Binding AffinityRangeText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource StrTopologyLegend}" Foreground="{StaticResource PcoFaintBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <Border Background="{StaticResource PcoBg3Brush}" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderThickness="1" BorderBrush="{StaticResource PcoBorderBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TopologyLimitation}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource StrTopologyNote}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PcoOrangeBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TopologyLimitation}" Style="{StaticResource PcoMutedText}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource StrCorePresets}" Style="{StaticResource PcoSectionHeader}"/>
                <TextBlock Text="{Binding PreviewPresetSummary, Mode=OneWay}" Foreground="{StaticResource PcoAccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewPresetId}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding CorePresets}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="10" Background="{StaticResource PcoBg3Brush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource PcoBorderSoftBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource PcoTextBrightBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource PcoMutedText}"/>
                                        <TextBlock Text="{Binding UnavailableReason}" Foreground="{StaticResource PcoOrangeBrush}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{DynamicResource StrPreviewPreset}" Style="{StaticResource SmallFilterButton}" Padding="12,0" Margin="10,0,0,0"
                                            Command="{Binding DataContext.PreviewCorePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}" IsEnabled="{Binding IsAvailable}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{DynamicResource StrCoreTopology}" Style="{StaticResource PcoSectionHeader}"/>
                <ItemsControl ItemsSource="{Binding Cores}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:CoreTile TileLabel="{Binding DisplayName, Mode=OneWay}" LoadUsage="{Binding LoadUsage, Mode=OneWay}" IsTileReadOnly="True" IsLoadAvailable="{Binding LoadAvailable, Mode=OneWay}" UtilityText="{Binding UtilityText, Mode=OneWay}">
                                <views:CoreTile.IsPreviewHighlighted>
                                    <MultiBinding Converter="{StaticResource PreviewHighlightConverter}">
                                        <Binding Path="Index"/>
                                        <Binding Path="DataContext.PreviewLogicalProcessors" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    </MultiBinding>
                                </views:CoreTile.IsPreviewHighlighted>
                            </views:CoreTile>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{DynamicResource StrAffinityExplained}" Foreground="{StaticResource PcoMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,4"/>
                <TextBlock Text="{DynamicResource StrCpuSetsExplained}" Foreground="{StaticResource PcoMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
