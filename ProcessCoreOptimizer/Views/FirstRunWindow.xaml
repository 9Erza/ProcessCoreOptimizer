<Window x:Class="ProcessCoreOptimizer.WPF.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Core Optimizer" Height="540" Width="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Border Background="{StaticResource PcoBg0Brush}" CornerRadius="8" BorderBrush="{StaticResource PcoBorderSoftBrush}" BorderThickness="1" Padding="28" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page 0: welcome + language -->
            <StackPanel Grid.Row="0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PageIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{DynamicResource StrWizardWelcome}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,12" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource StrWizardWelcomeBody}" Foreground="{StaticResource PcoTextBrush}" FontSize="14" Margin="0,0,0,20" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource StrLanguage}" Foreground="{StaticResource PcoTextBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="English" IsChecked="{Binding IsEnglishLanguage, Mode=TwoWay}" GroupName="WizardLang" Foreground="{StaticResource PcoTextBrush}" FontSize="14" Margin="0,0,20,0" VerticalContentAlignment="Center"/>
                    <RadioButton Content="Polski" IsChecked="{Binding IsPolishLanguage, Mode=TwoWay}" GroupName="WizardLang" Foreground="{StaticResource PcoTextBrush}" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Page 1: Affinity vs CPU Sets -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PageIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <TextBlock Text="{DynamicResource StrWizardModesTitle}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource StrWizardModesBody}" Foreground="{StaticResource PcoTextBrush}" FontSize="14" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource StrWizardModesNote}" Style="{StaticResource PcoMutedText}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Page 2: startup -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PageIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <TextBlock Text="{DynamicResource StrWizardStartupTitle}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <CheckBox Content="{DynamicResource StrStartWindows}" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,12">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <TextBlock Text="{DynamicResource StrStartupWindowBehavior}" Foreground="{StaticResource PcoTextBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding StartupWindowModes}" SelectedItem="{Binding WindowMode, Mode=TwoWay}" Width="220" HorizontalAlignment="Left" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12"/>
                    <CheckBox Content="{DynamicResource StrStartupRunElevated}" IsChecked="{Binding RunElevated}" Margin="0,0,0,8">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <TextBlock Text="{DynamicResource StrWizardNoAdminNote}" Style="{StaticResource PcoMutedText}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{DynamicResource StrWizardSkip}" Command="{Binding SkipCommand}" Padding="16,0" Height="36" Margin="0,0,8,0" Style="{StaticResource SmallFilterButton}"/>
                <Button Content="{DynamicResource StrWizardBack}" Command="{Binding BackCommand}" Padding="16,0" Height="36" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SmallFilterButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFirstPage}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{DynamicResource StrWizardNext}" Command="{Binding NextCommand}" Padding="16,0" Height="36" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SmallFilterButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLastPage}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{DynamicResource StrWizardFinish}" Command="{Binding FinishCommand}" Background="{StaticResource PcoAccentBrush}" Padding="20,0" Height="36" FontSize="14">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource StandardButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLastPage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
