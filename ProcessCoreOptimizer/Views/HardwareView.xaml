<UserControl x:Class="ProcessCoreOptimizer.WPF.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource PcoCard}">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PcoMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PcoTextBrightBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource PcoDisplayFontFamily}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,10"/>
        </Style>
        <Style x:Key="DetailRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="DetailKey" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PcoMutedBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PcoTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="0,0,4,0">
            <TextBlock Text="{DynamicResource StrHardwareMonitor}" Style="{StaticResource PcoTitle}"/>
            <TextBlock Text="{DynamicResource StrPageHardwareSub}" Style="{StaticResource PcoSubtitle}"/>

            <!-- On/off switch -->
            <Border Style="{StaticResource PcoCard}" Padding="18,14" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox Style="{StaticResource PcoToggleSwitch}" IsChecked="{Binding IsHardwareMonitorEnabled, Mode=TwoWay}">
                        <TextBlock Text="{DynamicResource StrHardwareMonitorSwitch}" FontWeight="SemiBold" Foreground="{StaticResource PcoTextBrightBrush}"/>
                    </CheckBox>
                    <TextBlock Text="{DynamicResource StrHardwareMonitorOffInfo}" Margin="0,4,56,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PcoMutedText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHardwareMonitorEnabled}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource PcoGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource StrBackgroundWatcherStatus}" Foreground="{StaticResource PcoMuted2Brush}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Off: compact empty state -->
            <Border Padding="24,20">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PcoInset}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHardwareMonitorEnabled}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource PcoIcon}" FontSize="26" Foreground="{StaticResource PcoDimBrush}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource StrHwEmptyTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource PcoTextBrightBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource StrHwEmptyBody}" Style="{StaticResource PcoMutedText}"/>
                </StackPanel>
            </Border>

            <!-- On: metrics -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHardwareMonitorEnabled}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <UniformGrid Columns="3" Margin="0,0,-12,0">
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource StrCpuUsage}" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding FullMetrics.CpuLoad, StringFormat={}{0:N1}%}" Style="{StaticResource MetricValue}"/>
                            <ProgressBar Value="{Binding FullMetrics.CpuLoad}" Maximum="100"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource StrGpuUsage}" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding FullMetrics.GpuLoad, StringFormat={}{0:N1}%}" Style="{StaticResource MetricValue}"/>
                            <ProgressBar Value="{Binding FullMetrics.GpuLoad}" Maximum="100" Foreground="{StaticResource PcoPurpleBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource StrRamUsage}" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding FullMetrics.RamUsagePct, StringFormat={}{0:N1}%}" Style="{StaticResource MetricValue}"/>
                            <ProgressBar Value="{Binding FullMetrics.RamUsagePct}" Maximum="100" Foreground="{StaticResource PcoGreenBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource StrCpuTemp}" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding FullMetrics.CpuTemp, StringFormat={}{0:N1}°C}" Style="{StaticResource MetricValue}"/>
                            <ProgressBar Value="{Binding FullMetrics.CpuTemp}" Maximum="100" Foreground="{StaticResource PcoOrangeBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource StrGpuTemp}" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding FullMetrics.GpuTemp, StringFormat={}{0:N1}°C}" Style="{StaticResource MetricValue}"/>
                            <ProgressBar Value="{Binding FullMetrics.GpuTemp}" Maximum="100" Foreground="{StaticResource PcoOrangeBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource StrRamUsedAvail}" Style="{StaticResource MetricLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                                <TextBlock Text="{Binding FullMetrics.RamUsedGB, StringFormat={}{0:N1}}" Style="{StaticResource MetricValue}" Margin="0"/>
                                <TextBlock Text="{Binding FullMetrics.RamAvailableGB, StringFormat='/ {0:N0} GB'}" Foreground="{StaticResource PcoDimBrush}" FontSize="16" Margin="8,0,0,4" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <ProgressBar Value="{Binding FullMetrics.RamUsagePct}" Maximum="100" Foreground="{StaticResource PcoGreenBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Expander Header="{DynamicResource StrExpandHardware}" Margin="0,4,0,8" IsEnabled="{Binding IsHardwareMonitorEnabled}">
                    <UniformGrid Columns="2" Margin="0,12,-12,0">
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource StrGpuDetails}" Style="{StaticResource PcoFieldLabel}" Margin="0,0,0,10"/>
                                <Grid Style="{StaticResource DetailRow}">
                                    <TextBlock Text="{DynamicResource StrVramUsage}" Style="{StaticResource DetailKey}"/>
                                    <TextBlock Text="{Binding FullMetrics.VramUsagePct, StringFormat={}{0:N1}%}" Style="{StaticResource DetailValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource DetailRow}">
                                    <TextBlock Text="{DynamicResource StrCoreClock}" Style="{StaticResource DetailKey}"/>
                                    <TextBlock Text="{Binding FullMetrics.GpuCoreClock, StringFormat={}{0:N0} MHz}" Style="{StaticResource DetailValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource DetailRow}">
                                    <TextBlock Text="{DynamicResource StrMemClock}" Style="{StaticResource DetailKey}"/>
                                    <TextBlock Text="{Binding FullMetrics.GpuMemClock, StringFormat={}{0:N0} MHz}" Style="{StaticResource DetailValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource DetailRow}">
                                    <TextBlock Text="{DynamicResource StrHotSpot}" Style="{StaticResource DetailKey}"/>
                                    <TextBlock Text="{Binding FullMetrics.GpuHotSpot, StringFormat={}{0:N1}°C}" Style="{StaticResource DetailValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource DetailRow}">
                                    <TextBlock Text="{DynamicResource StrVramTemp}" Style="{StaticResource DetailKey}"/>
                                    <TextBlock Text="{Binding FullMetrics.GpuVramTemp, StringFormat={}{0:N1}°C}" Style="{StaticResource DetailValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource DetailRow}">
                                    <TextBlock Text="{DynamicResource StrPowerDraw}" Style="{StaticResource DetailKey}"/>
                                    <TextBlock Text="{Binding FullMetrics.GpuPower, StringFormat={}{0:N1} W}" Style="{StaticResource DetailValue}" Foreground="{StaticResource PcoYellowBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource StrCpuDetails}" Style="{StaticResource PcoFieldLabel}" Margin="0,0,0,10"/>
                                <Grid Style="{StaticResource DetailRow}">
                                    <TextBlock Text="{DynamicResource StrAvgClock}" Style="{StaticResource DetailKey}"/>
                                    <TextBlock Text="{Binding FullMetrics.CpuClock, StringFormat={}{0:N0} MHz}" Style="{StaticResource DetailValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource DetailRow}">
                                    <TextBlock Text="{DynamicResource StrPowerDraw}" Style="{StaticResource DetailKey}"/>
                                    <TextBlock Text="{Binding FullMetrics.CpuPower, StringFormat={}{0:N1} W}" Style="{StaticResource DetailValue}" Foreground="{StaticResource PcoYellowBrush}"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource StrCoreTemps}" Style="{StaticResource DetailKey}" Margin="0,10,0,6" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding FullMetrics.CoreTemps}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource PcoMuted2Brush}" Margin="0,2,8,0" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Expander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
