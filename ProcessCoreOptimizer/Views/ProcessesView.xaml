<UserControl x:Class="ProcessCoreOptimizer.WPF.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ap="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Border Style="{StaticResource PcoCard}" Margin="0,0,25,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{DynamicResource StrProcessList}" Style="{StaticResource PcoTitle}"/>
            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox Text="{Binding ProcessFilterText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PcoFilterBox}" ToolTip="{DynamicResource StrProcessFilter}" Width="190" Margin="0,0,0,4"/>
                <CheckBox Content="{DynamicResource StrViewInstances}" IsChecked="{Binding ShowInstances, Mode=TwoWay}" VerticalAlignment="Center" Margin="12,0,0,4" Foreground="{StaticResource PcoTextBrush}" ToolTip="{DynamicResource StrViewInstances}"/>
                <CheckBox Content="{DynamicResource StrOnlyOptimized}" IsChecked="{Binding ProcessOnlyOptimized, Mode=TwoWay}" VerticalAlignment="Center" Margin="12,0,0,4" Foreground="{StaticResource PcoTextBrush}"/>
                <CheckBox Content="{DynamicResource StrOnlyWithProfile}" IsChecked="{Binding ProcessOnlyWithProfile, Mode=TwoWay}" VerticalAlignment="Center" Margin="12,0,0,4" Foreground="{StaticResource PcoTextBrush}"/>
            </WrapPanel>
            <TextBlock Grid.Row="2" Text="{DynamicResource StrSelectProcessHint}" Foreground="{StaticResource PcoMutedBrush}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasProcessTarget}" Value="False"/>
                                    <Condition Binding="{Binding IsProcessListLoading}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Row="3" Text="{DynamicResource StrInitialLoading}" Foreground="{StaticResource PcoMutedBrush}" FontSize="12" Margin="0,0,0,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProcessListLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <DataGrid Grid.Row="4" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" CanUserSortColumns="True">
                <DataGrid.Style>
                    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInstanceView}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource StrCtxDetails}" Command="{Binding RefreshDetailsCommand}"/>
                        <MenuItem Header="{DynamicResource StrCtxCreateProfile}" Command="{Binding SaveProfileCommand}"/>
                        <MenuItem Header="{DynamicResource StrCtxCapture}" Command="{Binding CaptureLiveSettingsCommand}"/>
                        <MenuItem Header="{DynamicResource StrCtxPreview}" Command="{Binding PreviewChangesCommand}"/>
                        <MenuItem Header="{DynamicResource StrCtxApply}" Command="{Binding ApplySettingsCommand}"/>
                        <MenuItem Header="{DynamicResource StrCtxRestore}" Command="{Binding RestoreSettingsCommand}"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource StrCtxCopyPid}" Command="{Binding CopyPidCommand}"/>
                        <MenuItem Header="{DynamicResource StrCtxCopyPath}" Command="{Binding CopyExePathCommand}"/>
                        <MenuItem Header="{DynamicResource StrCtxOpenLocation}" Command="{Binding OpenFileLocationCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource PcoTextBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ModeTag}" Value="Affinity">
                                <Setter Property="Foreground" Value="{StaticResource PcoAccentBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ModeTag}" Value="CPU Sets">
                                <Setter Property="Foreground" Value="{StaticResource PcoGreenBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding DisplayName}" SortMemberPath="Name" Width="*" MinWidth="120" >
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource StrColName}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding InstanceCount}" SortMemberPath="InstanceCount" Width="84">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource StrColInstances}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Priority}" SortMemberPath="PriorityRank" Width="118">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource StrColPriority}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="High">
                                        <Setter Property="Foreground" Value="{StaticResource PcoRedBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Wysoki">
                                        <Setter Property="Foreground" Value="{StaticResource PcoRedBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Real Time">
                                        <Setter Property="Foreground" Value="{StaticResource PcoPurpleBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Czas Rzeczywisty">
                                        <Setter Property="Foreground" Value="{StaticResource PcoPurpleBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding RamUsageMB}" SortMemberPath="MemoryBytes" Width="88" >
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource StrColRam}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding CpuUsage}" SortMemberPath="CpuUsageValue" Width="84" >
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource StrColCpu}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Row="4" ItemsSource="{Binding InstanceRows}" SelectedItem="{Binding SelectedInstanceRow}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" CanUserSortColumns="True">
                <DataGrid.Style>
                    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInstanceView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource StrCtxDetails}" Command="{Binding RefreshDetailsCommand}"/>
                        <MenuItem Header="{DynamicResource StrCtxCreateProfile}" Command="{Binding CreateProfileFromInstanceCommand}"/>
                        <MenuItem Header="{DynamicResource StrCtxPreview}" Command="{Binding PreviewChangesCommand}"/>
                        <MenuItem Header="{DynamicResource StrCtxApply}" Command="{Binding ApplyToInstanceCommand}"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource StrCtxCopyPid}" Command="{Binding CopyPidCommand}"/>
                        <MenuItem Header="{DynamicResource StrCtxCopyPath}" Command="{Binding CopyExePathCommand}"/>
                        <MenuItem Header="{DynamicResource StrCtxOpenLocation}" Command="{Binding OpenFileLocationCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding ProcessId}" SortMemberPath="ProcessId" Width="60">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource StrColPid}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Name}" SortMemberPath="Name" Width="*" MinWidth="100">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource StrColName}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding CpuUsage}" SortMemberPath="CpuUsagePercent" Width="62">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource StrColCpu}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding RamUsageMB}" SortMemberPath="MemoryBytes" Width="64">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource StrColRam}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Priority}" SortMemberPath="PriorityRank" Width="96">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource StrColPriority}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ProfileName}" SortMemberPath="ProfileName" Width="100">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource StrColProfile}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding LastStatus}" SortMemberPath="LastStatus" Width="80">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{DynamicResource StrColStatus}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="5" Background="{StaticResource PcoBg3Brush}" CornerRadius="6" Padding="12" Margin="0,12,0,0" BorderThickness="1" BorderBrush="{StaticResource PcoBorderBrush}">
                <Grid DataContext="{Binding SelectedProcessDetails}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource StrProcessDetails}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PcoAccentBrush}"/>
                            <TextBlock Text="{Binding DataContext.TargetScopeLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="{StaticResource PcoAccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource StrSystemTargetWarning}" Foreground="{StaticResource PcoOrangeBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSystemTarget, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="&#xE711;" Style="{StaticResource WindowBtnStyle}" Width="28" Height="28"
                                Command="{Binding DataContext.CloseProcessTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="{DynamicResource StrClosePanel}"
                                ap:AutomationProperties.Name="{DynamicResource StrClosePanel}" VerticalAlignment="Top"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Foreground="{StaticResource PcoTextBrush}" FontSize="12" TextWrapping="Wrap">
                        <Run Text="PID: "/><Run Text="{Binding RepresentativePid, Mode=OneWay}"/><Run Text="   |   "/><Run Text="{Binding StartTimeLocalText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Grid.Row="2" Foreground="{StaticResource PcoMutedBrush}" FontSize="12" TextWrapping="Wrap" Text="{Binding ExecutablePath}"/>
                    <TextBlock Grid.Row="3" Foreground="{StaticResource PcoTextBrush}" FontSize="12">
                        <Run Text="Affinity: "/><Run Text="{Binding AffinityMask, Mode=OneWay}"/><Run Text=" ("/><Run Text="{Binding AffinitySource, Mode=OneWay}"/><Run Text=")   |   Priority: "/><Run Text="{Binding Priority, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Grid.Row="4" Foreground="{StaticResource PcoTextBrush}" FontSize="12" TextWrapping="Wrap">
                        <Run Text="Profile: "/><Run Text="{Binding AssignedProfileName, TargetNullValue=—, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Grid.Row="5" Foreground="{StaticResource PcoMutedBrush}" FontSize="12" TextWrapping="Wrap">
                        <Run Text="Last: "/><Run Text="{Binding LastStatus, TargetNullValue=—, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding LastMessage, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Grid.Row="8" Foreground="{StaticResource PcoMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="{DynamicResource StrWhyThis}"/><Run Text=" "/><Run Text="{Binding DataContext.ProfileMatchWhy, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                    </TextBlock>
                    <Grid Grid.Row="6" Margin="0,8,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.HasInsights, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Foreground="{StaticResource PcoTextBrush}" FontSize="12">
                            <Run Text="{DynamicResource StrCpuHistory}"/><Run Text=": "/><Run Text="{Binding DataContext.InsightsSummary, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                        </TextBlock>
                        <Polyline Grid.Row="1" Points="{Binding DataContext.CpuHistoryPoints, RelativeSource={RelativeSource AncestorType=UserControl}}" Stroke="{StaticResource PcoAccentBrush}" StrokeThickness="1.5" Stretch="Fill" Height="30" Margin="0,4,0,0"/>
                    </Grid>
                    <Grid Grid.Row="7" Margin="0,4,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.HasInsights, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Foreground="{StaticResource PcoTextBrush}" FontSize="12" Text="{DynamicResource StrMemHistory}"/>
                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <Polyline Points="{Binding DataContext.MemWsHistoryPoints, RelativeSource={RelativeSource AncestorType=UserControl}}" Stroke="{StaticResource PcoGreenBrush}" StrokeThickness="1.5" Stretch="Fill" Height="30"/>
                            <Polyline Points="{Binding DataContext.MemPrivateHistoryPoints, RelativeSource={RelativeSource AncestorType=UserControl}}" Stroke="{StaticResource PcoMutedBrush}" StrokeThickness="1" StrokeDashArray="3,2" Stretch="Fill" Height="30"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
