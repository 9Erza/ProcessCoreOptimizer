<UserControl x:Class="ProcessCoreOptimizer.WPF.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ap="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <UserControl.Resources>
        <!-- Priority emphasis: color only, no bold slabs. Matches EN + PL labels. -->
        <Style x:Key="PriorityCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="High"><Setter Property="Foreground" Value="{StaticResource PcoOrangeBrush}"/></Trigger>
                <Trigger Property="Text" Value="Wysoki"><Setter Property="Foreground" Value="{StaticResource PcoOrangeBrush}"/></Trigger>
                <Trigger Property="Text" Value="Above Normal"><Setter Property="Foreground" Value="{StaticResource PcoYellowBrush}"/></Trigger>
                <Trigger Property="Text" Value="Powyżej normalnego"><Setter Property="Foreground" Value="{StaticResource PcoYellowBrush}"/></Trigger>
                <Trigger Property="Text" Value="Real Time"><Setter Property="Foreground" Value="{StaticResource PcoPurpleBrush}"/></Trigger>
                <Trigger Property="Text" Value="Czas Rzeczywisty"><Setter Property="Foreground" Value="{StaticResource PcoPurpleBrush}"/></Trigger>
                <Trigger Property="Text" Value="Idle"><Setter Property="Foreground" Value="{StaticResource PcoDimBrush}"/></Trigger>
                <Trigger Property="Text" Value="Bezczynny"><Setter Property="Foreground" Value="{StaticResource PcoDimBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NumericCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="NumericHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource StrProcessList}" Style="{StaticResource PcoTitle}"/>
            <TextBlock Text="{DynamicResource StrPageProcessesSub}" Style="{StaticResource PcoSubtitle}"/>
        </StackPanel>

        <!-- Toolbar: search + filter chips -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding ProcessFilterText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PcoSearchBox}"
                     Tag="{DynamicResource StrProcessFilter}" Margin="0,0,10,0"
                     ap:AutomationProperties.Name="{DynamicResource StrProcessFilter}"/>
            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="{DynamicResource StrViewInstances}" IsChecked="{Binding ShowInstances, Mode=TwoWay}" Style="{StaticResource PcoFilterChip}" Margin="0,0,6,0"/>
                <CheckBox Content="{DynamicResource StrOnlyOptimized}" IsChecked="{Binding ProcessOnlyOptimized, Mode=TwoWay}" Style="{StaticResource PcoFilterChip}" Margin="0,0,6,0"/>
                <CheckBox Content="{DynamicResource StrOnlyWithProfile}" IsChecked="{Binding ProcessOnlyWithProfile, Mode=TwoWay}" Style="{StaticResource PcoFilterChip}"/>
            </WrapPanel>
        </Grid>

        <!-- List card -->
        <Border Grid.Row="2" Style="{StaticResource PcoCard}" Padding="8,4,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" CanUserSortColumns="True">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInstanceView}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource StrCtxDetails}" Command="{Binding RefreshDetailsCommand}"/>
                            <MenuItem Header="{DynamicResource StrCtxCreateProfile}" Command="{Binding SaveProfileCommand}"/>
                            <MenuItem Header="{DynamicResource StrCtxCapture}" Command="{Binding CaptureLiveSettingsCommand}"/>
                            <MenuItem Header="{DynamicResource StrCtxPreview}" Command="{Binding PreviewChangesCommand}"/>
                            <MenuItem Header="{DynamicResource StrCtxApply}" Command="{Binding ApplySettingsCommand}"/>
                            <MenuItem Header="{DynamicResource StrCtxRestore}" Command="{Binding RestoreSettingsCommand}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource StrCtxCopyPid}" Command="{Binding CopyPidCommand}"/>
                            <MenuItem Header="{DynamicResource StrCtxCopyPath}" Command="{Binding CopyExePathCommand}"/>
                            <MenuItem Header="{DynamicResource StrCtxOpenLocation}" Command="{Binding OpenFileLocationCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.RowStyle>
                        <!-- Optimized rows are tinted (blue = Affinity, green = CPU Sets). -->
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModeTag}" Value="Affinity">
                                    <Setter Property="Foreground" Value="{StaticResource PcoAccentLightBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ModeTag}" Value="CPU Sets">
                                    <Setter Property="Foreground" Value="{StaticResource PcoGreenBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding DisplayName}" SortMemberPath="Name" Width="*" MinWidth="140">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource StrColName}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding InstanceCount}" SortMemberPath="InstanceCount" Width="72"
                                            ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource StrColInstances}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Priority}" SortMemberPath="PriorityRank" Width="128" ElementStyle="{StaticResource PriorityCellText}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource StrColPriority}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding RamUsageMB}" SortMemberPath="MemoryBytes" Width="92"
                                            ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource StrColRam}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding CpuUsage}" SortMemberPath="CpuUsageValue" Width="72"
                                            ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource StrColCpu}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid Grid.Row="0" ItemsSource="{Binding InstanceRows}" SelectedItem="{Binding SelectedInstanceRow}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" CanUserSortColumns="True">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInstanceView}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource StrCtxDetails}" Command="{Binding RefreshDetailsCommand}"/>
                            <MenuItem Header="{DynamicResource StrCtxCreateProfile}" Command="{Binding CreateProfileFromInstanceCommand}"/>
                            <MenuItem Header="{DynamicResource StrCtxPreview}" Command="{Binding PreviewChangesCommand}"/>
                            <MenuItem Header="{DynamicResource StrCtxApply}" Command="{Binding ApplyToInstanceCommand}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource StrCtxCopyPid}" Command="{Binding CopyPidCommand}"/>
                            <MenuItem Header="{DynamicResource StrCtxCopyPath}" Command="{Binding CopyExePathCommand}"/>
                            <MenuItem Header="{DynamicResource StrCtxOpenLocation}" Command="{Binding OpenFileLocationCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding ProcessId}" SortMemberPath="ProcessId" Width="70"
                                            ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource StrColPid}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Name}" SortMemberPath="Name" Width="*" MinWidth="110">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource StrColName}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding CpuUsage}" SortMemberPath="CpuUsagePercent" Width="64"
                                            ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource StrColCpu}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding RamUsageMB}" SortMemberPath="MemoryBytes" Width="84"
                                            ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource NumericHeader}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource StrColRam}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Priority}" SortMemberPath="PriorityRank" Width="110" ElementStyle="{StaticResource PriorityCellText}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource StrColPriority}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding ProfileName}" SortMemberPath="ProfileName" Width="110">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource StrColProfile}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding LastStatus}" SortMemberPath="LastStatus" Width="90">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource StrColStatus}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- List status line: loading or "select a process" hint. -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,8,8,0">
                    <TextBlock Text="{DynamicResource StrSelectProcessHint}" Foreground="{StaticResource PcoDimBrush}" FontSize="12" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasProcessTarget}" Value="False"/>
                                            <Condition Binding="{Binding IsProcessListLoading}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{DynamicResource StrInitialLoading}" Foreground="{StaticResource PcoMutedBrush}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProcessListLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Details: shown only while a process is selected (no empty box otherwise). -->
        <Border Grid.Row="3" Margin="0,12,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource PcoCard}">
                    <Setter Property="Padding" Value="18,14"/>
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedProcessDetails}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid DataContext="{Binding SelectedProcessDetails}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource StrProcessDetails}" Style="{StaticResource PcoFieldLabel}" Margin="0,0,0,10"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="PID" Style="{StaticResource PcoKeyText}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource PcoValueText}">
                        <Run Text="{Binding RepresentativePid, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  " Foreground="{StaticResource PcoFaintBrush}"/><Run Text="{Binding StartTimeLocalText, Mode=OneWay}" Foreground="{StaticResource PcoMutedBrush}"/>
                    </TextBlock>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource StrDetailPath}" Style="{StaticResource PcoKeyText}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExecutablePath, Mode=OneWay}" Style="{StaticResource PcoValueText}"
                               Foreground="{StaticResource PcoMutedBrush}" FontFamily="{StaticResource PcoMonoFont}" FontSize="11.5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource StrDetailCpu}" Style="{StaticResource PcoKeyText}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PcoValueText}">
                        <Run Text="{Binding AffinityMask, Mode=OneWay}" FontFamily="{StaticResource PcoMonoFont}"/><Run Text="  ("/><Run Text="{Binding AffinitySource, Mode=OneWay}"/><Run Text=")  ·  "/><Run Text="{Binding Priority, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource StrDetailProfile}" Style="{StaticResource PcoKeyText}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AssignedProfileName, TargetNullValue=—, Mode=OneWay}" Style="{StaticResource PcoValueText}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource StrDetailLast}" Style="{StaticResource PcoKeyText}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource PcoValueText}" Foreground="{StaticResource PcoMutedBrush}">
                        <Run Text="{Binding LastStatus, TargetNullValue=—, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding LastMessage, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource StrWhyThis}" Style="{StaticResource PcoKeyText}" MaxWidth="140" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource PcoValueText}" Foreground="{StaticResource PcoMutedBrush}"
                               Text="{Binding DataContext.ProfileMatchWhy, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                </Grid>

                <!-- Live insights: CPU and memory sparklines. -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.HasInsights, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Foreground="{StaticResource PcoMutedBrush}" FontSize="11.5" Margin="0,0,0,6" TextTrimming="CharacterEllipsis">
                        <Run Text="{DynamicResource StrCpuHistory}"/><Run Text=":  "/><Run Text="{Binding DataContext.InsightsSummary, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="{StaticResource PcoTextBrush}"/>
                    </TextBlock>

                    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PcoBg2Brush}" CornerRadius="6" Padding="8,6" Height="46">
                        <Polyline Points="{Binding DataContext.CpuHistoryPoints, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Stroke="{StaticResource PcoAccentBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Stretch="Fill"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource PcoBg2Brush}" CornerRadius="6" Padding="8,6" Height="46"
                            ToolTip="{DynamicResource StrMemHistory}">
                        <Grid>
                            <Polyline Points="{Binding DataContext.MemWsHistoryPoints, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      Stroke="{StaticResource PcoGreenBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Stretch="Fill"/>
                            <Polyline Points="{Binding DataContext.MemPrivateHistoryPoints, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      Stroke="{StaticResource PcoMutedBrush}" StrokeThickness="1" StrokeDashArray="3,2" Stretch="Fill"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
