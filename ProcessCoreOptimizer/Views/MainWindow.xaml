<Window x:Class="ProcessCoreOptimizer.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ProcessCoreOptimizer.WPF.Views"
        xmlns:ap="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Process Core Optimizer" Height="750" Width="1100" MinWidth="1000" MinHeight="700"
        Icon="/Images/processcoreoptimizer.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Theme dictionaries live in Application.Resources (global); window-level
             resources intentionally left empty to avoid duplicate instances. -->
    </Window.Resources>

    <Border Background="{StaticResource PcoBg0Brush}" CornerRadius="8" BorderBrush="{StaticResource PcoBorderSoftBrush}" BorderThickness="1" SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="{StaticResource PcoBg1Brush}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource PcoBorderBrush}">
                <Border.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource PcoSlimScrollBar}"/>
                </Border.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel VerticalAlignment="Top">

                            <TextBlock Text="Process Core Optimizer" FontWeight="Bold" FontSize="17" Foreground="{StaticResource PcoAccentBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,20,0,8"/>

                            <Border Width="56" Height="56" Margin="0,0,0,16" CornerRadius="12" HorizontalAlignment="Center" ClipToBounds="True">
                                <Image Source="/Images/processcoreoptimizer.ico" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <Button Content="{DynamicResource StrSystemProcesses}" Command="{Binding SwitchTabCommand}" CommandParameter="Processes">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="Processes">
                                                <Setter Property="Background" Value="{StaticResource PcoSelectedBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{DynamicResource StrNavCpuTopology}" Command="{Binding SwitchTabCommand}" CommandParameter="Cpu">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="Cpu">
                                                <Setter Property="Background" Value="{StaticResource PcoSelectedBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{DynamicResource StrSavedProfiles}" Command="{Binding SwitchTabCommand}" CommandParameter="Profiles">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="Profiles">
                                                <Setter Property="Background" Value="{StaticResource PcoSelectedBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{DynamicResource StrSmartRules}" Command="{Binding SwitchTabCommand}" CommandParameter="Rules">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="Rules">
                                                <Setter Property="Background" Value="{StaticResource PcoSelectedBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{DynamicResource StrHardwareMonitor}" Command="{Binding SwitchTabCommand}" CommandParameter="Hardware">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="Hardware">
                                                <Setter Property="Background" Value="{StaticResource PcoSelectedBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{DynamicResource StrDiagnostics}" Command="{Binding SwitchTabCommand}" CommandParameter="Diagnostics">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="Diagnostics">
                                                <Setter Property="Background" Value="{StaticResource PcoSelectedBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{DynamicResource StrSettings}" Command="{Binding SwitchTabCommand}" CommandParameter="Settings" Margin="10,8,10,15">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="Settings">
                                                <Setter Property="Background" Value="{StaticResource PcoSelectedBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Mini activity console (~60 DIP): status dot + latest message.
                         Click opens Diagnostics with the full log history. -->
                    <Button Grid.Row="1" Margin="12,0,12,6" Style="{StaticResource PcoMiniConsoleButton}"
                            Command="{Binding SwitchTabCommand}" CommandParameter="Diagnostics"
                            ToolTip="{DynamicResource StrConsoleLog}"
                            ap:AutomationProperties.Name="{Binding ActivitySummary, Mode=OneWay}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource StrActivity}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PcoDimBrush}" VerticalAlignment="Center"/>
                                <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center" Margin="8,0,2,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource PcoGreenBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActivityStatus}" Value="Attention">
                                                    <Setter Property="Fill" Value="{StaticResource PcoOrangeBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActivityStatus}" Value="Error">
                                                    <Setter Property="Fill" Value="{StaticResource PcoRedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="{Binding ActivitySummary, Mode=OneWay}" Foreground="#A0A0A0" FontSize="11" FontFamily="Consolas"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxHeight="16"/>
                        </StackPanel>
                    </Button>

                    <Grid Grid.Row="2" Margin="12,0,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Developer / Project Hub: compact version card when collapsed,
                             full link list when expanded (same commands as About). -->
                        <Expander Grid.Row="0" x:Name="FooterExpander" Style="{StaticResource PcoFooterExpander}" Margin="0,0,0,8">
                            <Expander.Header>
                                <TextBlock Text="{Binding FooterTitle}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                            </Expander.Header>
                            <Expander.ToolTip>
                                <TextBlock>
                                    <Run Text="Process Core Optimizer v"/><Run Text="{Binding AppVersion, Mode=OneWay}"/>
                                </TextBlock>
                            </Expander.ToolTip>
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,4,0,0">
                                    <Button Style="{StaticResource PcoFooterRowButton}" Command="{Binding OpenRepositoryCommand}"
                                            ToolTip="{DynamicResource StrRepoTooltip}"
                                            ap:AutomationProperties.Name="{DynamicResource StrRepoTooltip}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Width="20"><ContentControl Content="{StaticResource IconGitHub}" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                            <TextBlock Text="{DynamicResource StrFooterRepoLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PcoFooterRowButton}" Command="{Binding OpenAuthorCommand}"
                                            ToolTip="{DynamicResource StrAuthorTooltip}"
                                            ap:AutomationProperties.Name="{DynamicResource StrAuthorTooltip}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Width="20"><ContentControl Content="{StaticResource IconGitHub}" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                            <TextBlock Text="9Erza" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PcoFooterRowButton}" Command="{Binding OpenWebsiteCommand}"
                                            ToolTip="{DynamicResource StrFooterWebsiteTooltip}"
                                            ap:AutomationProperties.Name="{DynamicResource StrFooterWebsiteTooltip}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Width="20"><ContentControl Content="{StaticResource IconGlobe}" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                            <TextBlock Text="DobryPC.pl" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PcoFooterRowButton}" Command="{Binding OpenSupportCommand}"
                                            ToolTip="{DynamicResource StrSupportTooltip}"
                                            ap:AutomationProperties.Name="{DynamicResource StrSupportTooltip}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Width="20"><Image Source="/Images/buymeacoffee.png" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Focusable="False"/></Grid>
                                            <TextBlock Text="{DynamicResource StrFooterSupportLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PcoFooterRowButton}" Command="{Binding OpenAboutCommand}"
                                            ToolTip="{DynamicResource StrSetGroupAbout}"
                                            ap:AutomationProperties.Name="{DynamicResource StrSetGroupAbout}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Width="20"><TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
                                            <TextBlock Text="{DynamicResource StrSetGroupAbout}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>

                        <!-- Slim quick links: repo + support while the hub is collapsed. -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded, ElementName=FooterExpander}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Style="{StaticResource IconLinkButton}" Command="{Binding OpenRepositoryCommand}"
                                    ToolTip="{DynamicResource StrRepoTooltip}"
                                    ap:AutomationProperties.Name="{DynamicResource StrRepoTooltip}"
                                    Margin="0,0,8,0">
                                <ContentControl Content="{StaticResource IconGitHub}" Focusable="False"/>
                            </Button>
                            <Button Style="{StaticResource IconLinkButton}" Command="{Binding OpenSupportCommand}"
                                    ToolTip="{DynamicResource StrSupportTooltip}"
                                    ap:AutomationProperties.Name="{DynamicResource StrSupportTooltip}">
                                <Image Source="/Images/buymeacoffee.png" Width="17" Height="17" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Focusable="False"/>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="0" Style="{StaticResource FlagSwitchStyle}" IsChecked="{Binding IsPolishLanguage}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="1" Margin="25,5,25,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <views:ProcessesView Grid.Column="0" Visibility="{Binding ViewProcesses}"/>
                <views:ProfilesView Grid.Column="0" Visibility="{Binding ViewProfiles}"/>
                <views:SmartRulesView Grid.Column="0" Grid.ColumnSpan="2" Visibility="{Binding ViewSmartRules}"/>
                <views:CpuView Grid.Column="0" Grid.ColumnSpan="2" Visibility="{Binding ViewCpu}"/>
                <views:HardwareView Grid.Column="0" Grid.ColumnSpan="2" Visibility="{Binding ViewHardwareMonitor}"/>
                <views:SettingsView Grid.Column="0" Grid.ColumnSpan="2" Visibility="{Binding ViewSettings}" x:Name="SettingsViewControl"/>
                <views:DiagnosticsView Grid.Column="0" Grid.ColumnSpan="2" Visibility="{Binding ViewDiagnostics}"/>

                <!-- Contextual target panel: only with a live selection, never without a target.
                     Narrow windows overlay it as a right-side drawer (IsNarrowLayout). -->
                <Border Grid.Column="1" MaxWidth="400">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PcoCard}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Width" Value="380"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ActiveTab}" Value="Processes"/>
                                        <Condition Binding="{Binding HasProcessTarget}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ActiveTab}" Value="Profiles"/>
                                        <Condition Binding="{Binding HasSavedProfileTarget}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsNarrowLayout}" Value="True">
                                    <Setter Property="Width" Value="340"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Panel.ZIndex" Value="5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource StrSelectedProcess}" Style="{StaticResource PcoTitle}"/>
                                <TextBlock Text="{Binding TargetScopeLabel, Mode=OneWay}" Foreground="{StaticResource PcoAccentBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="&#xE711;" Style="{StaticResource WindowBtnStyle}" Width="32" Height="32"
                                    Command="{Binding CloseProcessTargetCommand}" ToolTip="{DynamicResource StrClosePanel}"
                                    ap:AutomationProperties.Name="{DynamicResource StrClosePanel}" VerticalAlignment="Top"/>
                        </Grid>

                        <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,0,0,15">
                            <Button Content="{DynamicResource StrSelectAll}" Command="{Binding SelectAllCommand}" Style="{StaticResource SmallFilterButton}" Margin="0,0,5,5"/>
                            <Button Content="{DynamicResource StrClearAll}" Command="{Binding ClearAllCommand}" Style="{StaticResource SmallFilterButton}" Margin="5,0,0,5"/>
                            <Button Content="{Binding CpuVendorText}" Command="{Binding DisableSmtCommand}" Style="{StaticResource SmallFilterButton}" Margin="0,0,5,0"/>
                            <Button Content="{DynamicResource StrDisableECores}" Command="{Binding DisableECoresCommand}" IsEnabled="{Binding HasECores}" Style="{StaticResource SmallFilterButton}" Margin="5,0,0,0"/>
                        </UniformGrid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                            <ItemsControl ItemsSource="{Binding Cores}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <views:CoreTile TileLabel="{Binding DisplayName, Mode=OneWay}" IsTileChecked="{Binding IsChecked, Mode=TwoWay}" LoadUsage="{Binding LoadUsage, Mode=OneWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="{DynamicResource StrOptimizationMode}" FontWeight="Bold" FontSize="16" Margin="0,10,0,10" Foreground="{StaticResource PcoAccentBrush}"/>
                            <ComboBox ItemsSource="{Binding AvailableOptimizationModes}" SelectedItem="{Binding SelectedOptimizationMode, Mode=TwoWay}" Style="{StaticResource ModernComboBox}" Margin="0,0,0,15">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource PcoTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="Affinity">
                                                            <Setter Property="Text" Value="{DynamicResource ModeAffinity}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding}" Value="CpuSets">
                                                            <Setter Property="Text" Value="{DynamicResource ModeCpuSets}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="{DynamicResource StrSetPriority}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="{StaticResource PcoRedBrush}"/>
                            <ComboBox ItemsSource="{Binding AvailablePriorities}" SelectedItem="{Binding SelectedPriority, Mode=TwoWay}" Style="{StaticResource ModernComboBox}" Margin="0,0,0,20"/>

                            <Separator Background="#333" Margin="0,5,0,20"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Visibility="{Binding ViewProcesses}">
                            <Button Content="{DynamicResource StrSetAffinity}" Command="{Binding ApplySettingsCommand}" Background="{StaticResource PcoAccentBrush}" Margin="0,0,0,10" Style="{StaticResource StandardButton}"/>
                            <Button Content="{DynamicResource StrSaveProfile}" Command="{Binding SaveProfileCommand}" Background="{StaticResource PcoGreenBrush}" Margin="0,0,0,10" Style="{StaticResource StandardButton}"/>
                            <Button Content="{DynamicResource StrRestoreSettings}" Command="{Binding RestoreSettingsCommand}" Background="{StaticResource PcoControlBrush}" Style="{StaticResource StandardButton}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Visibility="{Binding ViewProfiles}">
                            <Button Content="{DynamicResource StrUpdateProfile}" Command="{Binding UpdateProfileCommand}" Background="{StaticResource PcoOrangeBrush}" Margin="0,0,0,10" Style="{StaticResource StandardButton}"/>
                            <Button Content="{DynamicResource StrDeleteProfile}" Command="{Binding DeleteProfileCommand}" Background="{StaticResource PcoRedBrush}" Style="{StaticResource StandardButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WindowBtnStyle}" Content="&#xE921;" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeIconBtn" Style="{StaticResource WindowBtnStyle}" Content="&#xE922;" Click="MaximizeButton_Click"/>
                    <Button Style="{StaticResource WindowCloseBtnStyle}" Content="&#xE8BB;" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
