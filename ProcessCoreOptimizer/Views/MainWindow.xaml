<Window x:Class="ProcessCoreOptimizer.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ProcessCoreOptimizer.WPF.Views"
        Title="Process Core Optimizer" Height="750" Width="1100" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Theme dictionaries live in Application.Resources (global); window-level
             resources intentionally left empty to avoid duplicate instances. -->
    </Window.Resources>

    <Border Background="{StaticResource PcoBg0Brush}" CornerRadius="8" BorderBrush="{StaticResource PcoBorderSoftBrush}" BorderThickness="1" SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="{StaticResource PcoBg1Brush}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource PcoBorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel VerticalAlignment="Top">

                            <TextBlock Text="Process Core Optimizer" FontWeight="Bold" FontSize="18" Foreground="{StaticResource PcoAccentBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,30,0,10"/>

                            <Border Width="64" Height="64" Margin="0,0,0,25" CornerRadius="12" HorizontalAlignment="Center" ClipToBounds="True">
                                <Image Source="/Images/processcoreoptimizer.ico" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <Button Content="{DynamicResource StrSystemProcesses}" Command="{Binding SwitchTabCommand}" CommandParameter="Processes">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="Processes">
                                                <Setter Property="Background" Value="{StaticResource PcoSelectedBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{DynamicResource StrNavCpuTopology}" Command="{Binding SwitchTabCommand}" CommandParameter="Cpu">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="Cpu">
                                                <Setter Property="Background" Value="{StaticResource PcoSelectedBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{DynamicResource StrSavedProfiles}" Command="{Binding SwitchTabCommand}" CommandParameter="Profiles">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="Profiles">
                                                <Setter Property="Background" Value="{StaticResource PcoSelectedBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{DynamicResource StrHardwareMonitor}" Command="{Binding SwitchTabCommand}" CommandParameter="Hardware">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="Hardware">
                                                <Setter Property="Background" Value="{StaticResource PcoSelectedBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{DynamicResource StrDiagnostics}" Command="{Binding SwitchTabCommand}" CommandParameter="Diagnostics">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="Diagnostics">
                                                <Setter Property="Background" Value="{StaticResource PcoSelectedBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <Button Content="{DynamicResource StrSettings}" Command="{Binding SwitchTabCommand}" CommandParameter="Settings" VerticalAlignment="Bottom" Margin="10,0,10,15">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveTab}" Value="Settings">
                                            <Setter Property="Background" Value="{StaticResource PcoSelectedBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="15,0,15,5" Height="220">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource StrConsoleLog}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PcoDimBrush}" Margin="5,0,0,8"/>
                        <Border Grid.Row="1" Background="{StaticResource PcoLogBgBrush}" BorderBrush="{StaticResource PcoBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="5">
                            <ListBox x:Name="LogConsole" ItemsSource="{Binding ActionLogs}" Background="Transparent" BorderThickness="0" Foreground="#A0A0A0" FontSize="11" FontFamily="Consolas" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel VerticalAlignment="Bottom"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="5,2,10,2"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="20,0,20,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.Column="0" Style="{StaticResource FlagSwitchStyle}" IsChecked="{Binding IsPolishLanguage}"/>
                        <TextBlock Grid.Column="1" Text="{Binding AppVersion, StringFormat=v{0}}" Foreground="{StaticResource PcoFaintBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="1" Margin="25,5,25,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <views:ProcessesView Grid.Column="0" Visibility="{Binding ViewProcesses}"/>
                <views:ProfilesView Grid.Column="0" Visibility="{Binding ViewProfiles}"/>
                <views:CpuView Grid.Column="0" Visibility="{Binding ViewCpu}"/>
                <views:HardwareView Grid.Column="0" Grid.ColumnSpan="2" Visibility="{Binding ViewHardwareMonitor}"/>
                <views:SettingsView Grid.Column="0" Grid.ColumnSpan="2" Visibility="{Binding ViewSettings}"/>
                <views:DiagnosticsView Grid.Column="0" Grid.ColumnSpan="2" Visibility="{Binding ViewDiagnostics}"/>

                <Border Grid.Column="1">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PcoCard}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Hardware">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Settings">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Diagnostics">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{DynamicResource StrCpuCores}" Style="{StaticResource PcoTitle}"/>

                        <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,0,0,15">
                            <Button Content="{DynamicResource StrSelectAll}" Command="{Binding SelectAllCommand}" Style="{StaticResource SmallFilterButton}" Margin="0,0,5,5"/>
                            <Button Content="{DynamicResource StrClearAll}" Command="{Binding ClearAllCommand}" Style="{StaticResource SmallFilterButton}" Margin="5,0,0,5"/>
                            <Button Content="{Binding CpuVendorText}" Command="{Binding DisableSmtCommand}" Style="{StaticResource SmallFilterButton}" Margin="0,0,5,0"/>
                            <Button Content="{DynamicResource StrDisableECores}" Command="{Binding DisableECoresCommand}" IsEnabled="{Binding HasECores}" Style="{StaticResource SmallFilterButton}" Margin="5,0,0,0"/>
                        </UniformGrid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                            <ItemsControl ItemsSource="{Binding Cores}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4" Padding="10" Background="{StaticResource PcoBg3Brush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource PcoBorderSoftBrush}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <CheckBox Grid.Row="0" IsChecked="{Binding IsChecked}" Content="{Binding DisplayName}"/>
                                                <ProgressBar Grid.Row="1" Value="{Binding LoadUsage}" Maximum="100" Height="4" Margin="0,8,0,0" Foreground="{StaticResource PcoAccentBrush}" Background="#111" BorderThickness="0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="{DynamicResource StrOptimizationMode}" FontWeight="Bold" FontSize="16" Margin="0,10,0,10" Foreground="{StaticResource PcoAccentBrush}"/>
                            <ComboBox ItemsSource="{Binding AvailableOptimizationModes}" SelectedItem="{Binding SelectedOptimizationMode, Mode=TwoWay}" Style="{StaticResource ModernComboBox}" Margin="0,0,0,15">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource PcoTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="Affinity">
                                                            <Setter Property="Text" Value="{DynamicResource ModeAffinity}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding}" Value="CpuSets">
                                                            <Setter Property="Text" Value="{DynamicResource ModeCpuSets}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="{DynamicResource StrSetPriority}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="{StaticResource PcoRedBrush}"/>
                            <ComboBox ItemsSource="{Binding AvailablePriorities}" SelectedItem="{Binding SelectedPriority, Mode=TwoWay}" Style="{StaticResource ModernComboBox}" Margin="0,0,0,20"/>

                            <Separator Background="#333" Margin="0,5,0,20"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Visibility="{Binding ViewProcesses}">
                            <Button Content="{DynamicResource StrSetAffinity}" Command="{Binding ApplySettingsCommand}" Background="{StaticResource PcoAccentBrush}" Margin="0,0,0,10" Style="{StaticResource StandardButton}"/>
                            <Button Content="{DynamicResource StrSaveProfile}" Command="{Binding SaveProfileCommand}" Background="{StaticResource PcoGreenBrush}" Margin="0,0,0,10" Style="{StaticResource StandardButton}"/>
                            <Button Content="{DynamicResource StrRestoreSettings}" Command="{Binding RestoreSettingsCommand}" Background="{StaticResource PcoControlBrush}" Style="{StaticResource StandardButton}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Visibility="{Binding ViewProfiles}">
                            <Button Content="{DynamicResource StrUpdateProfile}" Command="{Binding UpdateProfileCommand}" Background="{StaticResource PcoOrangeBrush}" Margin="0,0,0,10" Style="{StaticResource StandardButton}"/>
                            <Button Content="{DynamicResource StrDeleteProfile}" Command="{Binding DeleteProfileCommand}" Background="{StaticResource PcoRedBrush}" Style="{StaticResource StandardButton}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Visibility="{Binding ViewCpu}">
                            <Button Content="{DynamicResource StrSetAffinity}" Command="{Binding ApplySettingsCommand}" Background="{StaticResource PcoAccentBrush}" Style="{StaticResource StandardButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WindowBtnStyle}" Content="&#xE921;" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeIconBtn" Style="{StaticResource WindowBtnStyle}" Content="&#xE922;" Click="MaximizeButton_Click"/>
                    <Button Style="{StaticResource WindowCloseBtnStyle}" Content="&#xE8BB;" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
