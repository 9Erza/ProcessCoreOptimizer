<UserControl x:Class="ProcessCoreOptimizer.WPF.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ProcessCoreOptimizer.WPF.Converters">
    <UserControl.Resources>
        <conv:OperationStatusTextConverter x:Key="OpStatusText"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="0,0,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource StrDiagnostics}" Style="{StaticResource PcoTitle}"/>
                    <TextBlock Text="{DynamicResource StrPageDiagnosticsSub}" Style="{StaticResource PcoSubtitle}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource StrExportDiagnostics}" Command="{Binding ExportDiagnosticsCommand}" Style="{StaticResource SmallFilterButton}"
                        VerticalAlignment="Top" Margin="16,2,0,0" AutomationProperties.Name="Export diagnostics"/>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Watcher -->
                <Border Grid.Column="0" Style="{StaticResource PcoCard}" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource StrWatcherTitle}" Style="{StaticResource PcoFieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource PcoGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource StrBackgroundWatcherStatus}" Foreground="{StaticResource PcoMuted2Brush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding WatcherStatusText}" Style="{StaticResource PcoMutedText}"/>
                    </StackPanel>
                </Border>

                <!-- Conflicts -->
                <Border Grid.Column="2" Style="{StaticResource PcoCard}" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource StrConflictsTitle}" Style="{StaticResource PcoFieldLabel}"/>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PcoMutedText}">
                                    <Setter Property="Text" Value="{DynamicResource StrNoConflicts}"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProfileConflicts}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding ProfileConflicts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Style="{StaticResource PcoWarningInset}" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource PcoOrangeBrush}" FontWeight="SemiBold" FontSize="12.5"/>
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource PcoMutedText}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent operations + rule decisions -->
            <Border Style="{StaticResource PcoCard}" Padding="18,14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource StrRecentOps}" Style="{StaticResource PcoFieldLabel}"/>
                    <TextBlock Text="{Binding RuleStatusText}" Style="{StaticResource PcoMutedText}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding RecentRuleDecisions}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{StaticResource PcoMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                    <Run Text="{Binding RuleName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource PcoTextBrush}"/><Run Text="  →  PID "/><Run Text="{Binding Key.ProcessId, Mode=OneWay}"/><Run Text=":  "/><Run Text="{Binding Reason, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DataGrid ItemsSource="{Binding RecentOperations}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding ProcessName}" Width="*">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate><TextBlock Text="{DynamicResource StrColName}"/></DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Status, Converter={StaticResource OpStatusText}}" Width="Auto" MinWidth="130">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate><TextBlock Text="{DynamicResource StrColStatus}"/></DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Message}" Width="2*">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate><TextBlock Text="{DynamicResource StrColMessage}"/></DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Full log -->
            <TextBlock Text="{DynamicResource StrConsoleLog}" Style="{StaticResource PcoFieldLabel}"/>
            <Border Background="{StaticResource PcoLogBgBrush}" BorderBrush="{StaticResource PcoBorderSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="8" MinHeight="160" Margin="0,0,0,8">
                <ListBox x:Name="DiagLogConsole" ItemsSource="{Binding ActionLogs}" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource PcoMuted2Brush}" FontSize="11.5" FontFamily="{StaticResource PcoMonoFont}" MaxHeight="300"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel VerticalAlignment="Bottom"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
