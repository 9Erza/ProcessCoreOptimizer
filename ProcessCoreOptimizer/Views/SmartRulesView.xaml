<UserControl x:Class="ProcessCoreOptimizer.WPF.Views.SmartRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SelectionButton" TargetType="Button" BasedOn="{StaticResource SmallFilterButton}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelectedRule}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource StrSmartRules}" Style="{StaticResource PcoTitle}"/>
            <TextBlock Text="{DynamicResource StrPageRulesSub}" Style="{StaticResource PcoSubtitle}"/>
        </StackPanel>

        <!-- Automation switch + status, and rule actions -->
        <Border Grid.Row="1" Style="{StaticResource PcoCard}" Padding="18,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <CheckBox Content="{DynamicResource StrPauseAutomation}" IsChecked="{Binding AutomationPaused, Mode=TwoWay}"
                              AutomationProperties.Name="Pause automatic optimization"/>
                    <TextBlock Text="{Binding RuleStatusText}" Style="{StaticResource PcoMutedText}" Margin="28,4,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource StrEditProfile}" Command="{Binding EditRuleCommand}" Style="{StaticResource SelectionButton}"/>
                    <Button Content="{DynamicResource StrCtxToggleEnabled}" Command="{Binding ToggleRuleEnabledCommand}" Style="{StaticResource SelectionButton}"/>
                    <Button Content="{DynamicResource StrClearOverride}" Command="{Binding ClearRuleOverrideCommand}" Style="{StaticResource SelectionButton}"/>
                    <Button Content="{DynamicResource StrDeleteRule}" Command="{Binding DeleteRuleCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PcoDangerButton}">
                                <Setter Property="Margin" Value="0,0,6,0"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedRule}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{DynamicResource StrNewRule}" Command="{Binding NewRuleCommand}" Style="{StaticResource PcoPrimaryButton}" Height="32"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Empty state -->
        <Border Grid.Row="2" Padding="32,28" VerticalAlignment="Top">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource PcoCard}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRules}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel MaxWidth="460" HorizontalAlignment="Left">
                <TextBlock Text="&#xE945;" Style="{StaticResource PcoIcon}" FontSize="28" Foreground="{StaticResource PcoAccentLightBrush}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                <TextBlock Text="{DynamicResource StrNoRulesTitle}" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource PcoTextBrightBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="{DynamicResource StrNoRulesBody}" Style="{StaticResource PcoMutedText}" FontSize="13" Margin="0,0,0,18"/>
                <Button Content="{DynamicResource StrNewRule}" Command="{Binding NewRuleCommand}" Style="{StaticResource PcoPrimaryButton}" MinWidth="150" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- Rules list -->
        <Border Grid.Row="2" Padding="8,4,8,8">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource PcoCard}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRules}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" CanUserSortColumns="True">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource StrEditProfile}" Command="{Binding EditRuleCommand}"/>
                        <MenuItem Header="{DynamicResource StrCtxToggleEnabled}" Command="{Binding ToggleRuleEnabledCommand}"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource StrClearOverride}" Command="{Binding ClearRuleOverrideCommand}"/>
                        <MenuItem Header="{DynamicResource StrDeleteRule}" Command="{Binding DeleteRuleCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Name}" SortMemberPath="Name" Width="*" MinWidth="120">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate><TextBlock Text="{DynamicResource StrColName}"/></DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ProcessName}" SortMemberPath="ProcessName" Width="150">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate><TextBlock Text="{DynamicResource StrRuleProcess}"/></DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Trigger}" SortMemberPath="Trigger" Width="120">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate><TextBlock Text="{DynamicResource StrRuleTrigger}"/></DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Action}" SortMemberPath="Action" Width="120">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate><TextBlock Text="{DynamicResource StrRuleAction}"/></DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Priority}" SortMemberPath="Priority" Width="90">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate><TextBlock Text="{DynamicResource StrRulePriority}"/></DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Recent activity -->
        <Border Grid.Row="3" Style="{StaticResource PcoCard}" Padding="18,14" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource StrRuleRecent}" Style="{StaticResource PcoFieldLabel}"/>
                <TextBlock Text="—" Foreground="{StaticResource PcoFaintBrush}" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecentRuleDecisions.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding RecentRuleDecisions}" MaxHeight="120">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{StaticResource PcoMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                <Run Text="{Binding RuleName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource PcoTextBrush}"/><Run Text="  →  PID "/><Run Text="{Binding Key.ProcessId, Mode=OneWay}"/><Run Text=":  "/><Run Text="{Binding Reason, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
