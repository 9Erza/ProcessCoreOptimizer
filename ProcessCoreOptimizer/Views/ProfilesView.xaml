<UserControl x:Class="ProcessCoreOptimizer.WPF.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ap="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource StrYourProfiles}" Style="{StaticResource PcoTitle}"/>
            <TextBlock Text="{DynamicResource StrPageProfilesSub}" Style="{StaticResource PcoSubtitle}"/>
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSavedProfiles}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="300" MinWidth="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding ProfileFilterText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PcoSearchBox}"
                     Tag="{DynamicResource StrProfileFilter}" Margin="0,0,10,0" ap:AutomationProperties.Name="{DynamicResource StrProfileFilter}"/>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{DynamicResource StrCaptureLive}" Command="{Binding CaptureLiveSettingsCommand}" Style="{StaticResource SmallFilterButton}" Margin="0,0,6,0"/>
                <Button Content="{DynamicResource StrImportProfiles}" Command="{Binding ImportProfilesCommand}" Style="{StaticResource SmallFilterButton}" Margin="0,0,6,0"/>
                <Button Content="{DynamicResource StrExportProfiles}" Command="{Binding ExportProfilesCommand}" Style="{StaticResource SmallFilterButton}" Margin="0,0,6,0"/>
                <Button Content="{DynamicResource StrNewProfile}" Command="{Binding NewProfileCommand}" Style="{StaticResource PcoPrimaryButton}" Height="32"/>
            </WrapPanel>
        </Grid>

        <!-- Conflicts -->
        <Border Grid.Row="2" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource PcoWarningInset}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasProfileConflicts}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{DynamicResource StrConflictsTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PcoOrangeBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding ConflictSummaryText}" Style="{StaticResource PcoMutedText}"/>
            </StackPanel>
        </Border>

        <!-- Empty state: no saved profiles yet. Only Create + Import here. -->
        <Border Grid.Row="3" Grid.RowSpan="2" Padding="32,28" VerticalAlignment="Top">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource PcoCard}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSavedProfiles}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                <TextBlock Text="&#xE728;" Style="{StaticResource PcoIcon}" FontSize="28" Foreground="{StaticResource PcoAccentLightBrush}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                <TextBlock Text="{DynamicResource StrNoProfilesTitle}" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource PcoTextBrightBrush}" Margin="0,0,0,6"/>
                <TextBlock Text="{DynamicResource StrNoProfilesBody}" Style="{StaticResource PcoMutedText}" FontSize="13" Margin="0,0,0,18"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource StrNewProfile}" Command="{Binding NewProfileCommand}" Style="{StaticResource PcoPrimaryButton}" MinWidth="150" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource StrImportProfiles}" Command="{Binding ImportProfilesCommand}" Style="{StaticResource PcoSecondaryButton}" MinWidth="120"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- List -->
        <Border Grid.Row="4" Padding="8,4,8,8">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource PcoCard}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSavedProfiles}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" ItemsSource="{Binding SavedProfiles}" SelectedItem="{Binding SelectedSavedProfile}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" CanUserSortColumns="True">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource StrEditProfile}" Command="{Binding EditProfileCommand}"/>
                            <MenuItem Header="{DynamicResource StrCtxToggleEnabled}" Command="{Binding ToggleProfileEnabledCommand}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource StrDeleteProfile}" Command="{Binding DeleteProfileCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding ProcessName}" SortMemberPath="ProcessName" Width="*" MinWidth="140">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource StrColName}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding DisplayPriority}" SortMemberPath="Priority" Width="130">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource StrColPriority}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="High"><Setter Property="Foreground" Value="{StaticResource PcoOrangeBrush}"/></Trigger>
                                        <Trigger Property="Text" Value="Wysoki"><Setter Property="Foreground" Value="{StaticResource PcoOrangeBrush}"/></Trigger>
                                        <Trigger Property="Text" Value="Real Time"><Setter Property="Foreground" Value="{StaticResource PcoPurpleBrush}"/></Trigger>
                                        <Trigger Property="Text" Value="Czas Rzeczywisty"><Setter Property="Foreground" Value="{StaticResource PcoPurpleBrush}"/></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="170" SortMemberPath="OptimizationMode">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource StrColMode}"/></DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource PcoBg3Brush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OptimizationMode}" Value="Affinity">
                                                        <Setter Property="Background" Value="{StaticResource PcoAccentSubtleBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OptimizationMode}" Value="CpuSets">
                                                        <Setter Property="Background" Value="{StaticResource PcoGreenSubtleBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource PcoTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OptimizationMode}" Value="Affinity">
                                                            <Setter Property="Text" Value="{DynamicResource ModeAffinity}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource PcoAccentLightBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding OptimizationMode}" Value="CpuSets">
                                                            <Setter Property="Text" Value="{DynamicResource ModeCpuSets}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource PcoGreenBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" Text="{DynamicResource StrSelectProfileHint}" Foreground="{StaticResource PcoDimBrush}" FontSize="12" Margin="8,8,8,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSavedProfiles}" Value="True"/>
                                        <Condition Binding="{Binding HasSavedProfileTarget}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Selection actions -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSavedProfileTarget}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Button Content="{DynamicResource StrEditProfile}" Command="{Binding EditProfileCommand}" Style="{StaticResource SmallFilterButton}" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource StrDuplicateProfile}" Command="{Binding DuplicateProfileCommand}" Style="{StaticResource SmallFilterButton}" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource StrCtxToggleEnabled}" Command="{Binding ToggleProfileEnabledCommand}" Style="{StaticResource SmallFilterButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
