<UserControl x:Class="ProcessCoreOptimizer.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ap="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="{DynamicResource StrAppSettings}" Style="{StaticResource PcoTitle}"/>
                <TextBlock Text="{DynamicResource StrPageSettingsSub}" Style="{StaticResource PcoSubtitle}"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Category navigation: pure selection, never persists anything. -->
                <ListBox Grid.Column="0" Margin="0,0,20,0" Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
                         SelectedValuePath="Tag" SelectedValue="{Binding ActiveSettingsCategory, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ap:AutomationProperties.Name="{DynamicResource StrAppSettings}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource PcoNavListItem}"/>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Tag="General" Content="{DynamicResource StrSetGroupGeneral}"/>
                    <ListBoxItem Tag="Startup" Content="{DynamicResource StrSetGroupStartup}"/>
                    <ListBoxItem Tag="Optimization" Content="{DynamicResource StrSetGroupOptimization}"/>
                    <ListBoxItem Tag="Hardware" Content="{DynamicResource StrSetGroupHardware}"/>
                    <ListBoxItem Tag="Diagnostics" Content="{DynamicResource StrSetGroupDiagnostics}"/>
                    <ListBoxItem Tag="Updates" Content="{DynamicResource StrSetGroupUpdates}"/>
                    <ListBoxItem Tag="Data" Content="{DynamicResource StrSetGroupData}"/>
                    <ListBoxItem Tag="About" Content="{DynamicResource StrSetGroupAbout}"/>
                </ListBox>

                <Border Grid.Column="1" Style="{StaticResource PcoCard}" Padding="24,6,24,8" VerticalAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Stretch" Margin="0,0,8,0">

                        <!-- General -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSettingsCategory}" Value="General">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{DynamicResource StrSetGroupGeneral}" Style="{StaticResource PcoSectionHeader}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="{DynamicResource StrLanguage}" Foreground="{StaticResource PcoTextBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguageName, Mode=TwoWay}" Width="150" Style="{StaticResource ModernComboBox}"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource PcoToggleSwitch}" Content="{DynamicResource StrMinToTray}" IsChecked="{Binding AppSettings.MinimizeToTray}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,16"/>
                            <CheckBox Style="{StaticResource PcoToggleSwitch}" Content="{DynamicResource StrCloseToTray}" IsChecked="{Binding AppSettings.CloseToTray}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource StrTrayHint}" Foreground="{StaticResource PcoMutedBrush}" FontSize="12" Margin="0,0,56,20" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Startup & Privileges -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSettingsCategory}" Value="Startup">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{DynamicResource StrSetGroupStartup}" Style="{StaticResource PcoSectionHeader}"/>
                            <CheckBox Style="{StaticResource PcoToggleSwitch}" Content="{DynamicResource StrStartWindows}" IsChecked="{Binding AppSettings.StartWithWindows}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,16"/>
                            <TextBlock Text="{DynamicResource StrStartupWindowBehavior}" Style="{StaticResource PcoFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding StartupWindowModes}" SelectedItem="{Binding SelectedStartupWindowMode, Mode=TwoWay}" Width="220" HorizontalAlignment="Left" Style="{StaticResource ModernComboBox}" Margin="0,0,0,15"/>
                            <CheckBox Style="{StaticResource PcoToggleSwitch}" Content="{DynamicResource StrStartupRunElevated}" IsChecked="{Binding AppSettings.StartupRunElevated}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource StrStartupElevatedHint}" Foreground="{StaticResource PcoMutedBrush}" FontSize="12" Margin="0,0,56,16" TextWrapping="Wrap"/>

                            <Border Style="{StaticResource PcoInset}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource StrStartupStatus}" Style="{StaticResource PcoCaption}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding StartupStatusText}" Foreground="{StaticResource PcoTextBrightBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding StartupDetailText}" Style="{StaticResource PcoMutedText}" Margin="0,4,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{DynamicResource StrStartupRefresh}" Command="{Binding RefreshStartupStatusCommand}" Style="{StaticResource SmallFilterButton}" Margin="0,0,8,0"/>
                                        <Button Content="{DynamicResource StrStartupRepair}" Command="{Binding RepairStartupCommand}" Style="{StaticResource SmallFilterButton}" Margin="0,0,8,0"
                                                ToolTip="{DynamicResource StrStartupRepairHint}"/>
                                        <TextBlock Text="{DynamicResource StrStartupWorking}" VerticalAlignment="Center" Foreground="{StaticResource PcoOrangeBrush}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStartupBusy}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="{DynamicResource StrCurrentPrivileges}" Foreground="{StaticResource PcoTextBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding CurrentPrivilegesText}" Foreground="{StaticResource PcoGreenBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="{DynamicResource StrRestartAsAdmin}" Command="{Binding RestartAsAdministratorCommand}" Style="{StaticResource SmallFilterButton}" HorizontalAlignment="Left" Margin="0,8,0,20"/>
                        </StackPanel>

                        <!-- Optimization -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSettingsCategory}" Value="Optimization">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{DynamicResource StrSetGroupOptimization}" Style="{StaticResource PcoSectionHeader}"/>
                            <CheckBox Style="{StaticResource PcoToggleSwitch}" Content="{DynamicResource StrAllowRealtime}" IsChecked="{Binding AppSettings.AllowRealtimePriority}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource StrRealtimeWarn}" Foreground="{StaticResource PcoMutedBrush}" FontSize="12" Margin="0,0,56,20" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Hardware monitoring -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSettingsCategory}" Value="Hardware">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{DynamicResource StrSetGroupHardware}" Style="{StaticResource PcoSectionHeader}"/>
                            <CheckBox Style="{StaticResource PcoToggleSwitch}" Content="{DynamicResource StrEnableStorageSensors}" IsChecked="{Binding AppSettings.EnableStorageSensors}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource StrStorageSensorsWarn}" Foreground="{StaticResource PcoMutedBrush}" FontSize="12" Margin="0,0,56,20" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Diagnostics -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSettingsCategory}" Value="Diagnostics">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{DynamicResource StrSetGroupDiagnostics}" Style="{StaticResource PcoSectionHeader}"/>
                            <CheckBox Style="{StaticResource PcoToggleSwitch}" Content="{DynamicResource StrLogEnabled}" IsChecked="{Binding AppSettings.LogEnabled}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,16"/>
                        </StackPanel>

                        <!-- Updates -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSettingsCategory}" Value="Updates">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{DynamicResource StrSetGroupUpdates}" Style="{StaticResource PcoSectionHeader}"/>
                            <CheckBox Style="{StaticResource PcoToggleSwitch}" Content="{DynamicResource StrCheckUpdates}" IsChecked="{Binding AppSettings.CheckForUpdates}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,14"/>
                            <Button Content="{DynamicResource StrCheckUpdatesNow}" Command="{Binding CheckForUpdatesNowCommand}" Style="{StaticResource SmallFilterButton}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding UpdateStatusText, Mode=OneWay}" Style="{StaticResource PcoMutedText}" Margin="0,0,0,20" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Data & reset -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSettingsCategory}" Value="Data">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{DynamicResource StrSetGroupData}" Style="{StaticResource PcoSectionHeader}"/>
                            <Button Content="{DynamicResource StrOpenWizard}" Command="{Binding OpenWizardCommand}" Style="{StaticResource SmallFilterButton}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                            <Button Content="{DynamicResource StrRestoreDefaults}" Command="{Binding RestoreDefaultsCommand}" Style="{StaticResource SmallFilterButton}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding DataResetStatusText}" Style="{StaticResource PcoMutedText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <Border Style="{StaticResource PcoDangerInset}" Margin="0,8,0,20">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource StrFactoryResetTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PcoRedBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource StrFactoryResetWarning}" Style="{StaticResource PcoMutedText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding FactoryResetConfirmationText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PcoFilterBox}" Tag="RESET" ToolTip="RESET" MaxWidth="260" HorizontalAlignment="Left" MinWidth="200"/>
                                    <Button Content="{DynamicResource StrFactoryReset}" Command="{Binding FactoryResetCommand}" Style="{StaticResource PcoDangerButton}" HorizontalAlignment="Left" IsEnabled="{Binding IsFactoryResetArmed}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- About -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSettingsCategory}" Value="About">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock x:Name="AboutHeader" Text="{DynamicResource StrSetGroupAbout}" Style="{StaticResource PcoSectionHeader}" Focusable="True"/>
                            <TextBlock Text="{DynamicResource StrAboutLine}" Style="{StaticResource PcoMutedText}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconLinkButton}" Command="{Binding OpenAuthorCommand}"
                                        ToolTip="{DynamicResource StrAuthorTooltip}"
                                        ap:AutomationProperties.Name="{DynamicResource StrAuthorTooltip}"
                                        Margin="0,0,8,0" Focusable="True">
                                    <ContentControl Content="{StaticResource IconGitHub}" Focusable="False"/>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource StrDeveloper}" Foreground="{StaticResource PcoMutedBrush}" FontSize="11"/>
                                    <Button Content="9Erza" Command="{Binding OpenAuthorCommand}" Style="{StaticResource LinkTextButton}" ToolTip="{DynamicResource StrAuthorTooltip}" ap:AutomationProperties.Name="9Erza"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconLinkButton}" Command="{Binding OpenRepositoryCommand}"
                                        ToolTip="{DynamicResource StrRepoTooltip}"
                                        ap:AutomationProperties.Name="{DynamicResource StrRepoTooltip}"
                                        Margin="0,0,8,0" Focusable="True">
                                    <ContentControl Content="{StaticResource IconGitHub}" Focusable="False"/>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource StrSourceCode}" Foreground="{StaticResource PcoMutedBrush}" FontSize="11"/>
                                    <Button Content="Process Core Optimizer" Command="{Binding OpenRepositoryCommand}" Style="{StaticResource LinkTextButton}" ToolTip="{DynamicResource StrRepoTooltip}" ap:AutomationProperties.Name="Process Core Optimizer"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconLinkButton}" Command="{Binding OpenSupportCommand}"
                                        ToolTip="{DynamicResource StrSupportTooltip}"
                                        ap:AutomationProperties.Name="{DynamicResource StrSupportTooltip}"
                                        Margin="0,0,8,0" Focusable="True">
                                    <ContentControl Content="{StaticResource IconCoffee}" Focusable="False"/>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource StrSupportDev}" Foreground="{StaticResource PcoMutedBrush}" FontSize="11"/>
                                    <Button Content="Buy Me a Coffee" Command="{Binding OpenSupportCommand}" Style="{StaticResource LinkTextButton}" ToolTip="{DynamicResource StrSupportTooltip}" ap:AutomationProperties.Name="Buy Me a Coffee"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconLinkButton}" Command="{Binding OpenWebsiteCommand}"
                                        ToolTip="{DynamicResource StrFooterWebsiteTooltip}"
                                        ap:AutomationProperties.Name="{DynamicResource StrFooterWebsiteTooltip}"
                                        Margin="0,0,8,0" Focusable="True">
                                    <ContentControl Content="{StaticResource IconGlobe}" Focusable="False"/>
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource StrWebsiteCaption}" Foreground="{StaticResource PcoMutedBrush}" FontSize="11"/>
                                    <Button Content="DobryPC.pl" Command="{Binding OpenWebsiteCommand}" Style="{StaticResource LinkTextButton}" ToolTip="{DynamicResource StrFooterWebsiteTooltip}" ap:AutomationProperties.Name="DobryPC.pl"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding ExternalLinkErrorText}" Foreground="{StaticResource PcoRedBrush}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ExternalLinkErrorText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource PcoMutedBrush}" FontSize="12" Margin="0,0,0,20" TextWrapping="Wrap">
                                <Run Text="Process Core Optimizer v"/><Run Text="{Binding AppVersion, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
</UserControl>
