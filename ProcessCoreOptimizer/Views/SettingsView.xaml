<UserControl x:Class="ProcessCoreOptimizer.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PcoCard}" Grid.ColumnSpan="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{DynamicResource StrAppSettings}" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,30"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Width="400" HorizontalAlignment="Left">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <TextBlock Text="{DynamicResource StrLanguage}" Foreground="{StaticResource PcoTextBrush}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguageName, Mode=TwoWay}" Width="150" Style="{StaticResource ModernComboBox}"/>
                    </StackPanel>

                    <CheckBox Content="{DynamicResource StrStartWindows}" IsChecked="{Binding AppSettings.StartWithWindows}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,20">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <CheckBox Content="{DynamicResource StrStartMinimized}" IsChecked="{Binding AppSettings.StartMinimized}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,20">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <CheckBox Content="{DynamicResource StrMinToTray}" IsChecked="{Binding AppSettings.MinimizeToTray}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,20">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <CheckBox Content="{DynamicResource StrCloseToTray}" IsChecked="{Binding AppSettings.CloseToTray}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,20">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <Separator Background="#333" Margin="0,10,0,20"/>
                    <CheckBox Content="{DynamicResource StrStartAdmin}" IsChecked="{Binding AppSettings.RunAsAdministrator}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,5">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <TextBlock Text="{DynamicResource StrAdminReq}" Foreground="{StaticResource PcoMutedBrush}" FontSize="11" Margin="35,0,0,20"/>

                    <Separator Background="#333" Margin="0,10,0,20"/>
                    <CheckBox Content="{DynamicResource StrAllowRealtime}" IsChecked="{Binding AppSettings.AllowRealtimePriority}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,5">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <TextBlock Text="{DynamicResource StrRealtimeWarn}" Foreground="{StaticResource PcoMutedBrush}" FontSize="11" Margin="35,0,0,20" TextWrapping="Wrap"/>

                    <CheckBox Content="{DynamicResource StrLogEnabled}" IsChecked="{Binding AppSettings.LogEnabled}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,20">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>

                    <CheckBox Content="{DynamicResource StrCheckUpdates}" IsChecked="{Binding AppSettings.CheckForUpdates}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,20">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>

                    <CheckBox Content="{DynamicResource StrEnableStorageSensors}" IsChecked="{Binding AppSettings.EnableStorageSensors}" Command="{Binding ToggleSettingCommand}" Margin="0,0,0,5">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <TextBlock Text="{DynamicResource StrStorageSensorsWarn}" Foreground="{StaticResource PcoMutedBrush}" FontSize="11" Margin="35,0,0,20" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
