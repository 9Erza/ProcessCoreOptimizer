# Visual Studio local cache
.vs/

# Build output
bin/
obj/

# User-specific Visual Studio files
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / JetBrains
.idea/

# Logs
*.log

# Local QA evidence (screenshots, measurements) - never committed
.evidence/

# Publish output
publish/

# Installer build output (binary, reproducible via tools/Build-Installer.ps1)
installer/Output/
installer/*.exe

# Release staging binaries (reproducible via tools/Build-Installer.ps1 and
# tools/Build-Portable.ps1). Only checksums + manifest are tracked.
release-staging/*
!release-staging/SHA256SUMS.txt
!release-staging/release-manifest.json

# OS files
.DS_Store
Thumbs.db
desktop.ini