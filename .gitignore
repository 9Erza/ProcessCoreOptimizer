# Visual Studio local cache
.vs/

# Build output
bin/
obj/

# User-specific Visual Studio files
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / JetBrains
.idea/

# Logs
*.log

# Local QA evidence (screenshots, measurements) - never committed
.evidence/

# Test results and coverage (regenerated by dotnet test)
TestResults/
*.trx
*.coverage
*.coveragexml
coverage*/
TestCoverageReport/

# Publish output
publish/

# Installer build output (binary, reproducible via tools/Build-Installer.ps1)
installer/Output/
installer/*.exe

# Release staging binaries (reproducible via tools/Build-Installer.ps1).
# The whole directory is local-only: per-build SHA-256 values are generated
# artifacts and must not be versioned (commit -> new SHA -> new commit loop).
release-staging/*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Crash dumps and temporary profiling artifacts
*.dmp
*.mdmp